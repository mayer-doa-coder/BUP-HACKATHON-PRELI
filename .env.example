# GridWise configuration template.
# Copy to .env and fill in the secret values locally. NEVER commit a populated .env.

APP_ENV=production
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------- LLM
# Pin an exact structured-output-capable model snapshot rather than a drifting alias.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_ATTEMPT_TIMEOUT_SECONDS=3.2
LLM_MAX_ATTEMPTS=2
PROMPT_VERSION=gridwise-parser-v1
SCHEMA_VERSION=gridwise-directives-v1

# Optional pretested backup provider. Leave blank to disable.
BACKUP_LLM_PROVIDER=
BACKUP_LLM_MODEL=
BACKUP_LLM_API_KEY=

# ------------------------------------------------------------------------ budgets
# Soft budget = full-credit latency target. Hard deadline < the organizer's 30 s timeout.
SOFT_RESPONSE_BUDGET_SECONDS=4.5
HARD_REQUEST_DEADLINE_SECONDS=28

# -------------------------------------------------------------------------- cache
REQUEST_CACHE_SIZE=512
REQUEST_CACHE_TTL_SECONDS=1800

# ------------------------------------------------------------- resource limits
# Engineering protections, not organizer rules. Keep them generous for judge traffic.
MAX_REQUEST_BODY_BYTES=131072
MAX_NOTE_CHARS=16384
MAX_CONCURRENT_REQUESTS=32
MAX_CONCURRENT_LLM_CALLS=16
OVERSIZED_REQUEST_STATUS=413

# ---------------------------------------------------------------------- optimizer
OPTIMIZER_MODE=lp_milp_hybrid
LP_SOLVER_METHOD=highs
MILP_SOLVER=highs
MILP_TIME_LIMIT_SECONDS=3
INTERNAL_TOLERANCE=1e-7
JUDGE_TOLERANCE=0.01
OPTIMIZER_VERSION=lp-milp-v1
RESPONSE_DECIMAL_PLACES=6
SOLVER_EPSILON=1e-9

# --------------------------------------------------- provisional spec-gap policies
# Update these if the organizers clarify the corresponding specification gap.
CROSS_MIDNIGHT_POLICY=modulo_24_provisional
THROUGH_RANGE_POLICY=end_exclusive_provisional
SOLAR_OVERLAP_POLICY=min_factor_provisional
REJECT_NEGATIVE_ENERGY_INPUTS=true

# -------------------------------------------------------------------- diagnostics
APP_COMMIT_SHA=
JUDGE_MODE=true
DEMO_MODE=false
LOG_LEVEL=INFO
LOG_RAW_OPERATOR_NOTES=false
LOG_LLM_RAW_OUTPUT=false

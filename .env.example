# GridWise configuration template.
# Copy to .env and fill in the secret values locally. NEVER commit a populated .env.

APP_ENV=production
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------- LLM
# Pin an exact structured-output-capable model snapshot rather than a drifting alias.
# Supported values: openai | openai_compatible | azure_openai | gateway | anthropic | claude
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# Leave blank to use the provider's own default host; set it for a gateway or proxy.
LLM_BASE_URL=
# Per-attempt LLM timeout. Keep this above a COLD call (~8 s), not a warm one (~3 s),
# or the first request after startup times out and fails.
LLM_ATTEMPT_TIMEOUT_SECONDS=12.0
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=2048
# Leave blank to omit the parameter entirely. KEEP IT BLANK unless you have confirmed the
# pinned model accepts an explicit temperature: some models answer 400 unsupported_value
# instead of ignoring it, which makes every /optimize-energy call fail with a 500.
LLM_TEMPERATURE=
PROMPT_VERSION=gridwise-parser-v1
SCHEMA_VERSION=gridwise-directives-v1

# Optional pretested backup provider. Leave blank to disable.
# Only configure one that has already passed the same semantic corpus as the primary.
BACKUP_LLM_PROVIDER=
BACKUP_LLM_MODEL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_BASE_URL=

# ------------------------------------------------------------------------ budgets
# Soft budget = full-credit latency target. Hard deadline < the organizer's 30 s timeout.
SOFT_RESPONSE_BUDGET_SECONDS=4.5
HARD_REQUEST_DEADLINE_SECONDS=28

# -------------------------------------------------------------------------- cache
REQUEST_CACHE_SIZE=512
REQUEST_CACHE_TTL_SECONDS=1800

# ------------------------------------------------------------- resource limits
# Engineering protections, not organizer rules. Keep them generous for judge traffic.
MAX_REQUEST_BODY_BYTES=131072
MAX_NOTE_CHARS=16384
MAX_CONCURRENT_REQUESTS=32
MAX_CONCURRENT_LLM_CALLS=16
OVERSIZED_REQUEST_STATUS=413

# ---------------------------------------------------------------------- optimizer
OPTIMIZER_MODE=lp_milp_hybrid
LP_SOLVER_METHOD=highs
MILP_SOLVER=highs
MILP_TIME_LIMIT_SECONDS=3
# 0 = solve to exact optimality. HiGHS would otherwise stop at a 1e-4 relative gap
# and still report success, costing optimization points for nothing.
MILP_RELATIVE_GAP=0.0
INTERNAL_TOLERANCE=1e-7
JUDGE_TOLERANCE=0.01
OPTIMIZER_VERSION=lp-milp-v1
RESPONSE_DECIMAL_PLACES=6
SOLVER_EPSILON=1e-9

# --------------------------------------------------- provisional spec-gap policies
# Update these if the organizers clarify the corresponding specification gap.
CROSS_MIDNIGHT_POLICY=modulo_24_provisional
THROUGH_RANGE_POLICY=end_exclusive_provisional
SOLAR_OVERLAP_POLICY=min_factor_provisional
REJECT_NEGATIVE_ENERGY_INPUTS=true

# -------------------------------------------------------------------- diagnostics
APP_COMMIT_SHA=
# Prometheus metrics on /metrics (operational only; not part of the judged contract).
METRICS_ENABLED=true
JUDGE_MODE=true
DEMO_MODE=false
LOG_LEVEL=INFO
LOG_RAW_OPERATOR_NOTES=false
LOG_LLM_RAW_OUTPUT=false

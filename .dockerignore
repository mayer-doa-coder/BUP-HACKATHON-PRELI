# Keep credentials, history, and local state out of the image entirely.
.git
.gitignore
.env
.env.*
!.env.example
*.key
*.pem

.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

tests/
docs/
dashboard/
replay_bundles/
benchmark_results/
*.log
*.md
!README.md
